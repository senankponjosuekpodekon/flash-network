# JWT
JWT_SECRET=your_jwt_secret_here

# Encryption key for wallet private keys (AES-256-CBC)
ENCRYPTION_KEY=your_encryption_key_here

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/flash_network

# TRON network (nile or mainnet)
TRON_NETWORK=nile

# TRON
PRIVATE_KEY=your_tron_private_key_here
TRON_API_KEY=your_tron_pro_api_key_here

# FLASH contract address (after deployment on Nile)
FLASH_CONTRACT_ADDRESS=

# Test wallet private key (for send-deposit test script)
TEST_PRIVATE_KEY=your_test_wallet_private_key_here

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=http://localhost:3000

# Server port
PORT=3000
